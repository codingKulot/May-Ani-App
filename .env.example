# Copy this file to ".env" (same folder as package.json) and paste your key after the equals sign.
# Get a key at https://console.anthropic.com  (never share it or commit the .env file).
ANTHROPIC_API_KEY=

# Accounts (Sign up / Log in). Paste your MongoDB address here. See README "Turning on accounts".
#   MongoDB Atlas (cloud):  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#   MongoDB on this PC:     mongodb://127.0.0.1:27017
MONGODB_URI=
# MONGODB_DB=may_ani    # database name (default may_ani)

# "Forgot your password?" emails, sent from a Gmail account. See README "Turning on password reset".
#   SMTP_USER:     the Gmail address that sends the emails (best: a new Gmail just for May-Ani)
#   SMTP_PASSWORD: its 16-letter APP password from https://myaccount.google.com/apppasswords (NOT your normal Gmail password)
SMTP_USER=
SMTP_PASSWORD=
# APP_URL=http://localhost:8787   # where the link in the email opens the app. Phones need this PC's address or your website.
# EMAIL_FROM=May-Ani <mayani.app@gmail.com>   # the name people see (default "May-Ani <SMTP_USER>")

# Daily AI allowance: each AI check and picture costs money on YOUR accounts (README "Putting May-Ani online safely").
# Only logged-in users can use May-Ani (and its AI). 0 means none. The defaults are shown.
# AI_DAILY_ACCOUNT=20         # AI checks per account per day
# AI_DAILY_TOTAL=300          # the whole server per day
# PICTURES_DAILY_ACCOUNT=9
# PICTURES_DAILY_TOTAL=60

# Online: your website address (stops other websites using this server from their pages), and the proxy in front, if any.
# ALLOWED_ORIGIN=https://your-website
# TRUST_PROXY=loopback        # loopback (Cloudflare Tunnel, Caddy, nginx on this PC) | 1 (proxies in front) | proxy IP addresses

# Logs and several copies of the server (README "Running more than one server")
# LOG_FORMAT=text       # text (plain sentences, the default) | json (one JSON line per request, for log tools)
# INSTANCE_ID=          # a name for this copy in the logs (default: computer name and process number)

# Database backups with "bun scripts/backup.ts" (README "Backing up your data"): how many to keep (older ones are deleted),
# and where they go (a folder inside May-Ani, or a full path like D:\May-Ani backups). The defaults are shown.
# BACKUP_KEEP=14
# BACKUP_DIR=backups

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_MS=90000   # how long to wait for the AI
# AI_RATE_PER_MIN=15    # AI checks per minute per phone/IP (each one costs money)
# PORT=8787

# Realistic picture of your garden on your photo (optional, costs a few cents per picture on YOUR account).
# Claude cannot draw pictures, so this uses a separate image model. Fill in ONE of these:
# GEMINI_API_KEY=       (https://aistudio.google.com/apikey)
# OPENAI_API_KEY=       (https://platform.openai.com/api-keys)
# IMAGE_PROVIDER=gemini # only needed when both keys are set
# GEMINI_IMAGE_MODEL=   # override if the default model name is retired
# OPENAI_IMAGE_MODEL=
