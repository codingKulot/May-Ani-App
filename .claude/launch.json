{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "server",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "start"],
      "port": 8787
    },
    {
      "name": "server-safe",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--env-file=scripts/safe.env", "server/index.mjs"],
      "port": 8790
    },
    {
      "name": "server-test-db",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--env-file=scripts/test-db.env", "server/index.mjs"],
      "port": 8791
    }
  ]
}
