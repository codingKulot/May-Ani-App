# A SECOND copy of the server on the same throwaway MongoDB as scripts/test-db.env (the "server-test-db-2" preview), for
# checking in the browser that two copies work together: a phone on port 8791 and a phone on port 8792 chat live.
#   bun --env-file=scripts/test-db-2.env server/index.mjs
# Run "bun run build" and "bun scripts/test-db.ts" first. Every key is named here (a single space = off), so the server's own
# .env reader never fills in the real keys or the owner's Atlas address.
PORT=8792
ANTHROPIC_API_KEY=" "
GEMINI_API_KEY=" "
OPENAI_API_KEY=" "
MONGODB_URI=mongodb://127.0.0.1:27999/
MONGODB_DB=may_ani_browser_check
SMTP_USER=" "
SMTP_PASSWORD=" "
APP_URL=http://localhost:8792
DATA_FILE=server/data.json.test-2
INSTANCE_ID=copy-2
