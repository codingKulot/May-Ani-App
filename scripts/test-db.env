# The real server with a THROWAWAY MongoDB (scripts/test-db.ts, port 27999) and every paid service and email OFF, for checking
# log-in, sync and chat in the browser:  bun --env-file=scripts/test-db.env server/index.mjs   (the "server-test-db" preview)
# Run "bun run build" first. With --env-file, Bun does not read .env; every key is named here (a single space = off), so the
# server's own .env reader never fills in the real keys or the owner's Atlas address.
PORT=8791
ANTHROPIC_API_KEY=" "
GEMINI_API_KEY=" "
OPENAI_API_KEY=" "
MONGODB_URI=mongodb://127.0.0.1:27999/
MONGODB_DB=may_ani_browser_check
SMTP_USER=" "
SMTP_PASSWORD=" "
APP_URL=http://localhost:8791
DATA_FILE=server/data.json.test
