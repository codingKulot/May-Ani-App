# The real server with every paid service, email and the owner's database switched OFF, for browser checks:
#   bun --env-file=scripts/safe.env server/index.mjs      (the "server-safe" entry in .claude/launch.json; run "bun run build" first)
# With --env-file, Bun does not read .env. The server's own .env reader only fills in settings that are still missing,
# so every key is named here with a single space, which means "off". The real keys in .env are never used.
PORT=8790
ANTHROPIC_API_KEY=" "
GEMINI_API_KEY=" "
OPENAI_API_KEY=" "
MONGODB_URI=" "
SMTP_USER=" "
SMTP_PASSWORD=" "
APP_URL=http://localhost:8790
DATA_FILE=server/data.json.safe
